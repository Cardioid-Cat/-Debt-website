<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>💪 {{ room.title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; font-family: 'Inter', sans-serif; }
        .card { border-radius: 15px; border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .btn-primary { background-color: #FF5A50; border: none; }
        .btn-primary:hover { background-color: #E54E45; }
        .debt-badge { background: #EDF2F7; color: #2D3748; padding: 5px 10px; border-radius: 8px; font-weight: 600; }
    </style>
</head>
<body>
<div class="container py-4">
    <h1 class="mb-4">💪 {{ room.title }}</h1>

    {% if is_admin %}
        <div class="card p-3 bg-white">
            <h4>📝 Ввод данных (Админ)</h4>
            <form action="/add_log" method="POST" class="row g-3">
                <input type="hidden" name="slug" value="{{ room.slug }}">
                <div class="col-md-4">
                    <select name="profile_id" class="form-select">
                        {% for p in profiles %}
                            <option value="{{ p.id }}">{{ p.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <select name="ex_name" class="form-select">
                        {% for ex in ex_types %}
                            <option value="{{ ex.name }}">{{ ex.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" name="value" class="form-control" placeholder="Сколько?">
                </div>
                <div class="col-12">
                    <button type="submit" name="action" value="add" class="btn btn-primary">➕ Добавить долг</button>
                    <button type="submit" name="action" value="writeoff" class="btn btn-outline-success">✅ Списать</button>
                </div>
            </form>
        </div>
    {% else %}
        <div class="alert alert-light border">
            🔑 Для управления долгами войдите как админ.
            <form action="/login" method="POST" class="d-flex mt-2 gap-2">
                <input type="hidden" name="slug" value="{{ room.slug }}">
                <input type="password" name="password" class="form-control form-control-sm w-auto" placeholder="Пароль">
                <button class="btn btn-sm btn-dark">Войти</button>
            </form>
        </div>
    {% endif %}

    <hr>

    <h3 class="mt-4">📊 Текущие долги</h3>
    <div class="row">
        {% for name, debts in summary.items() %}
        <div class="col-md-6">
            <div class="card p-3">
                <h5>👤 {{ name }}</h5>
                <div class="d-flex flex-wrap gap-2">
                    {% for ex, total in debts.items() %}
                        {% if total != 0 %}
                            <div class="debt-badge">{{ ex }}: {{ total }}</div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
</body>
</html>
